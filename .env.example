# Copy to .env and edit for your deployment.
# This file is the source of truth for env-driven config consumed by
# docker-compose.yml. The defaults below match a CPU-only R530-style
# deployment (visual indexing enabled with ColSmolVLM, aggressive async queue).

# -----------------------------------------------------------------------------
# Backend selection
# -----------------------------------------------------------------------------
# Which backend handles ingest/search by default. The agent can override
# per-call with the `backend` arg on each tool.
INGEST_BACKEND=qdrant

# Default mode for search_documents when retrieval_mode isn't passed per-call.
# auto: fusion if KB has visual index, else text_only
RETRIEVAL_MODE=auto

# Default for ingest_document's enable_visual_index arg. true = ColPali side
# runs on every ingest unless the call explicitly opts out.
INGEST_DEFAULT_VISUAL_INDEX=true

# -----------------------------------------------------------------------------
# Text embeddings (llama-server)
# -----------------------------------------------------------------------------
# The model file in ./models that llama-server loads. Get with e.g.:
#   huggingface-cli download CompendiumLabs/bge-small-en-v1.5-gguf \
#     bge-small-en-v1.5-f16.gguf --local-dir ./models
LLAMA_MODEL_FILE=bge-small-en-v1.5-f16.gguf
LLAMA_CTX_SIZE=8192
# Concurrent embedding slots (--parallel). --ctx-size is divided across slots;
# keep ctx-per-slot above the model's token cap (512 for bge-*).
LLAMA_PARALLEL=4
LLAMA_PORT=8081

# GPU override only (docker-compose.gpu.yml). The base file always runs
# ghcr.io/ggml-org/llama.cpp:server on the CPU.
# Image for the CUDA build of llama-server.
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Layers offloaded to the GPU (--n-gpu-layers); 99 = the whole model.
# LLAMA_GPU_LAYERS=99

# Model name the Quarkus side reports in payload + cosmetically passes to
# llama-server (the value is just a label; llama-server ignores it).
EMBED_MODEL=bge-small-en-v1.5
EMBED_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# ColPali sidecar — CPU defaults below. These are the base docker-compose.yml
# defaults; docker-compose.gpu.yml (auto-loaded via the committed override
# symlink, or layered by `scripts/up.sh --gpu`) already flips the four marked
# variables to the GPU values noted above each one, so you only need to set them
# here to pin a non-default (e.g. a different model or dtype) — an explicit
# value here always wins over the override's fallback.
# -----------------------------------------------------------------------------
# GPU: Dockerfile.cuda
COLPALI_DOCKERFILE=Dockerfile.cpu
# GPU with 8 GB+ VRAM: vidore/colqwen2-v1.0
COLPALI_MODEL=vidore/colsmolvlm-v0.1
# GPU: cuda
COLPALI_DEVICE=cpu
# GPU: bfloat16
COLPALI_DTYPE=float32
# Sidecar cap on pages per /embed_pages request; the sidecar 400-rejects a
# larger request. docker-compose.gpu.yml's fallback is 16.
# CPU: 4. GPU with ColQwen2 on 8 GB: 4-8. 20 GB card (A4500) that also
# hosts the GPU text embedder, tomoro-colqwen3 at 1280 visual tokens: 12
# (docs/plans/gpu-text-embedder-v1.md).
COLPALI_MAX_BATCH_SIZE=4
# Java-side pages per embed request. Must equal COLPALI_MAX_BATCH_SIZE
# (a larger value is rejected; a smaller one wastes the GPU batch).
# docker-compose.gpu.yml's fallback is 16; set both to 12 on the 20 GB card.
COLPALI_BATCH_SIZE=4
COLPALI_PORT=8090

# PyTorch caching-allocator policy for the CUDA sidecar (GPU override only;
# docker-compose.gpu.yml and deploy/bigdumb-sidecar-compose.yml pass it).
# Default expandable_segments:True lets the allocator hand segments back so
# the sidecar does not grow to the whole card and starve llama-server.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Wire encoding the ingest service requests from the sidecar
# (ingest.colpali.wire-encoding): json | f32b64 | f16b64. Default f32b64:
# base64 float32, bit-identical to json, one-pass decode, 27 MB instead of
# 62 MB for a 12-page 1,280 x 320 batch. f16b64 halves that again and is
# exact for bf16 outputs above 6.1e-5. application.properties has no explicit
# mapping; the name below is the Quarkus (SmallRye) env convention.
# docker-compose.yml does not forward it: add it to the pdf-rag-http
# `environment:` block to set it in a compose deployment.
# INGEST_COLPALI_WIRE_ENCODING=f32b64

# Hub revision pin. Leave empty to track "main" — acceptable for the
# colpali-engine models, dangerous for trust_remote_code ones.
#
# TomoroAI/tomoro-colqwen3-embed-4b ships its own modeling_colqwen3.py, which
# the sidecar executes. On 2026-08-14 that repo migrated to transformers 5.x
# (commits be3da89 + e990968); its code now expects _tied_weights_keys to be a
# dict, while transformers 4.x hands it a list, so loading dies with
# "AttributeError: 'list' object has no attribute 'items'". Nothing changed on
# our side — a container recreate simply pulled the new remote code.
#
# bf790bd is the last revision that works with the transformers 4.x pin in
# sidecar/pyproject.toml. Same weights, same 320-dim head, so pinning it needs
# no re-index.
# COLPALI_MODEL_REVISION=bf790bd8780b098b86453444632a184bb770be1a

# A model change (e.g. ColSmolVLM → ColQwen2) produces a different vector dim
# than the existing <kb>_pages collections. Drop and re-ingest visual indexes
# after switching:
#   curl -X DELETE http://localhost:6333/collections/<kb>_pages

# -----------------------------------------------------------------------------
# Async ingest queue
# -----------------------------------------------------------------------------
# PDFs with >= this many pages get queued instead of running synchronously.
# Lower this on CPU sidecars (5 is a sensible R530-CPU default), raise it
# on GPU sidecars (50+ is fine on a 3070 / ColQwen2 — most ingests stay sync).
INGEST_ASYNC_THRESHOLD_PAGES=5
# CPU: 1. GPU: still 1 unless multi-GPU.
INGEST_QUEUE_WORKERS=1

# -----------------------------------------------------------------------------
# Ingest filesystem access (path-based / directory ingest)
# -----------------------------------------------------------------------------
# Inbox dir mounted read-only at /docs in the container (source_type=path and
# small curated drops). Default: ./incoming
# INGEST_INBOX=./incoming

# Host directory mounted read-only at /host for the REST directory-ingest
# endpoint — POST /ingest/directory with "directory": "/host/<path under this
# root>". Default: $HOME. Set to / to expose the entire host filesystem
# (Linux only; macOS Docker Desktop won't file-share "/"). The REST surface
# has no auth, so everything under this root becomes indexable + searchable
# by anyone who can reach the server port.
# INGEST_HOST_ROOT=/

# Mount options for the /host bind. On Linux, use "ro,rslave" so NFS/SMB
# shares (re)mounted on the host after the container starts stay visible
# inside it (the default rprivate freezes the container's view of submounts
# at creation time). Leave unset on macOS — Docker Desktop rejects rslave.
# INGEST_HOST_MOUNT_OPTS=ro,rslave

# -----------------------------------------------------------------------------
# Big-storage mounts (named volume by default; absolute path = bind mount)
# -----------------------------------------------------------------------------
# Same pattern for all three: a bare name stays a docker named volume, a
# leading / becomes a bind mount. On the R530 all three live on ZFS datasets.

# Qdrant vector storage. R530: /tank/qdrant
# QDRANT_DATA_DIR=/tank/qdrant

# Rendered page PNGs (~1 MB/page — the bulkiest artifact). R530: /tank/page-images
# PAGE_IMAGES_DIR=/tank/page-images

# Durable document store behind POST /ingest/upload (read-WRITE at /documents;
# the corpus of record — no reaper, files stay until deleted). R530:
# /tank/documents. Give it its own dataset with a quota so a fill can't starve
# the qdrant dataset:
#   zfs create -o recordsize=1M -o compression=lz4 -o quota=200G tank/documents
# INGEST_DOCUMENTS_DIR=/tank/documents

# HTTP body cap for uploads (Quarkus max-body-size; rejects with 413 while the
# body streams). Keep equal to INGEST_UPLOAD_MAX_REQUEST_BYTES if you change it.
# UPLOAD_MAX_BODY_SIZE=2G

# -----------------------------------------------------------------------------
# Fusion / retrieval
# -----------------------------------------------------------------------------
# or 'weighted'
FUSION_STRATEGY=rrf

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_PORT=6333
# Host port mapped to the container's gRPC port 6334.
QDRANT_GRPC_PORT=6334

# Transport for the page multivector upserts (ingest.qdrant.upsert-transport):
# grpc (packed float32 on port 6334, default) or rest (JSON on QDRANT_URL).
# Collections, deletes, searches and chunk upserts always use REST. A gRPC
# failure falls back to REST for that batch. The three names below follow the
# Quarkus (SmallRye) env convention; application.properties has no explicit
# mapping, and docker-compose.yml does not forward them: add them to the
# pdf-rag-http `environment:` block to set them in a compose deployment.
# INGEST_QDRANT_UPSERT_TRANSPORT=grpc
# gRPC host: auto = the host of QDRANT_URL (qdrant inside the compose network).
# INGEST_QDRANT_GRPC_HOST=auto
# gRPC port the ingest service dials (the container port, not QDRANT_GRPC_PORT).
# INGEST_QDRANT_GRPC_PORT=6334

# -----------------------------------------------------------------------------
# MCP HTTP transport
# -----------------------------------------------------------------------------
PDF_RAG_PORT=8080
# Restrict CORS for production. * is OK for an internal-only deployment.
MCP_CORS_ORIGINS=*

# JVM options for pdf-rag-http (passed as JAVA_TOOL_OPTIONS). Empty = the JDK
# ergonomic heap, 25% of host RAM. A bulk visual ingest with many queue
# workers filled the 30 GiB default on a 188 GiB host (R530, 2026-09-17);
# set e.g. -Xmx64g for a large-worker deployment.
# PDF_RAG_JAVA_TOOL_OPTIONS=-Xmx64g

# -----------------------------------------------------------------------------
# Open WebUI backend (OPTIONAL — leave unset to keep Qdrant-only)
# -----------------------------------------------------------------------------
# Uncomment and set if you want to wire OpenWebUiBackend as a parallel target.
# OPEN_WEBUI_BASE_URL=http://your-cluster-host:3000
# OPEN_WEBUI_API_KEY=
